# ─────────────────────────────────────────────────
# Samosbor AI Game v2 — Конфигурация
# Скопируйте в .env и заполните
# ─────────────────────────────────────────────────

# Telegram
TELEGRAM_BOT_TOKEN=
BOT_LANGUAGE=ru

# OpenRouter (LLM)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
LLM_MODEL=deepseek/deepseek-v4-flash

# PostgreSQL (основная БД)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=samosbor
POSTGRES_USER=samosbor
POSTGRES_PASSWORD=changeme

# PostgreSQL для Temporal
TEMPORAL_DB_HOST=temporal-db
TEMPORAL_DB_PORT=5432
TEMPORAL_DB_NAME=temporal
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=changeme

# Redis (кеш)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Langfuse (мониторинг LLM)
LANGFUSE_BASE_URL=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Embedding (RAG)
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=bge-m3
EMBEDDING_DIMS=1024

# Sentry (опционально)
SENTRY_DSN=

# Администраторы Telegram
ADMIN_USER_IDS=
ALLOWED_TELEGRAM_USER_IDS=*

# Стоимость одного сообщения (талонов)
COST_PER_MESSAGE=1

# Триал: сколько бесплатных сообщений для нового пользователя
TRIAL_MESSAGES=5

# Telegram Stars — пакеты для покупки (через запятую)
STAR_PACKAGES=50,100,200,500

# AI Image — генерация картинок (пусто = отключено)
AI_IMAGE_BASE_URL=https://image.pollinations.ai/prompt/soviet-bunker-
AI_IMAGE_CROP_URL=

# Ссылки для /buy (TOS, Privacy)
TOS_URL=https://samosbor.one/tos.html
PRIVACY_URL=https://samosbor.one/privacy.html

# Ссылка на Telegram-канал для приветствия
CHANNEL_URL=https://t.me/samosbor_ai

# Логирование
LOGGING_LEVEL=INFO